{
  "name": "admin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "release": "bash scripts/release.sh",
    "release:tag": "git tag -a v$(jq -r '.version' package.json) -m \"Release v$(jq -r '.version' package.json)\" && git push origin v$(jq -r '.version' package.json)"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/nprogress": "^0.2.3",
    "axios": "^1.7.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "mockjs": "^1.1.0",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "terser": "^5.46.1",
    "typescript": "~5.7.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
